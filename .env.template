# VPN
WIREGUARD_PRIVATE_KEY=your_key_here
WIREGUARD_ADDRESSES=your_ip_here
SERVER_CITIES=stuff
# Pihole
PIHOLE_PASSWORD=your_password_here
PIHOLE_LOCAL_IP=192.168.1.100

# Immich DB
IMMICH_DB_PASSWORD=your_password_here

# Disk Monitor
DISKMON_THRESHOLD=85
DISKMON_INTERVAL=5m
DISKMON_QB_USERNAME=
DISKMON_QB_PASSWORD=
DISKMON_NTFY_URL=ntfy://ntfy.sh/your-topic-here

# Station curator (channel programming)
# Jellyfin key is shared with render-lane. Radarr/Sonarr keys are read-only
# here -- used to dedupe acquisition suggestions, never to start a download.
# Find them in each app: Settings -> General -> API Key.
RADARR_API_KEY=
SONARR_API_KEY=
# Free read-only key from https://www.themoviedb.org/settings/api
# Blank = no acquisition shortlist; everything else still runs.
TMDB_API_KEY=
# Optional taste pass. Blank = the curator runs fully deterministically.
# Gemini is the default and needs no extra package (plain REST).
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Only if you switch: CURATOR_LLM_PROVIDER=anthropic (also needs the image
# rebuilt with --build-arg WITH_ANTHROPIC=1).
ANTHROPIC_API_KEY=
CURATOR_LLM_PROVIDER=
CURATOR_LLM_MODEL=
CURATOR_NTFY_URL=
# Where the report page is reachable from your phone (tailnet name).
CURATOR_REPORT_URL=http://optiplex:8477/
CURATOR_NTFY_PER_PUSH=8
# Set to 1 to log every add/retire without writing anything.
CURATOR_DRY_RUN=

# Timezone (shared)
TZ=America/New_York
PUID=1000
PGID=1000
